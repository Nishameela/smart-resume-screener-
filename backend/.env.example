# Which LLM provider call_structured() (app/core/llm_client.py) talks to.
# "anthropic" or "gemini" -- both SDKs ship as dependencies, so switching
# providers is just this one line plus the matching API key below. Every
# other module is unaware of which provider is active.
LLM_PROVIDER=gemini

# Anthropic API key. Required only when LLM_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini API key. Required only when LLM_PROVIDER=gemini.
# Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for ALL LLM stages by default (extraction, JD parsing, requirement evaluation).
# Kept as a single override for maximum quality; can be split per-stage later
# via LLM_MODEL_EXTRACTION / LLM_MODEL_EVALUATION once the pipeline is proven end-to-end.
# Leave blank to use the built-in default for whichever LLM_PROVIDER is active
# (see _PROVIDER_FALLBACK_MODELS in app/core/config.py) -- that way switching
# LLM_PROVIDER alone doesn't leave a stale model name from the other provider.
# Anthropic options: claude-sonnet-5 (default), claude-opus-5 (higher quality,
#   slower/costlier), claude-haiku-4-5 (cheap/fast).
# Gemini default: gemini-3.6-flash (confirmed working against the live API as
#   of Aug 2026 -- Gemini model names move fast and older generations get
#   retired for new callers, so if this 404s, run (from the backend/ dir)
#   ../scripts/verify_llm_provider.py to see the exact error, or list models
#   available to your key with:
#     python -c "from google import genai; c = genai.Client(); [print(m.name) for m in c.models.list()]"
LLM_MODEL_DEFAULT=

# Optional per-stage overrides. If unset, each stage falls back to LLM_MODEL_DEFAULT.
# LLM_MODEL_EXTRACTION=
# LLM_MODEL_EVALUATION=

# Request tuning
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# Database (SQLite file path, relative to backend/)
DATABASE_URL=sqlite:///./data/app.db

# Upload limits
MAX_UPLOAD_SIZE_MB=5

# CORS: comma-separated list of allowed frontend origins. Covers both
# "localhost" and "127.0.0.1" for Vite's dev (5173) and preview (4173)
# ports, since browsers treat those as distinct origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
